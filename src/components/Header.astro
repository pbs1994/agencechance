---
import { LANGS, ROUTES, UI, CONTACT, type Lang, type T } from '../i18n';
interface Props { lang: Lang; alternates: Partial<T>; overHero: boolean }
const { lang, alternates, overHero } = Astro.props;
const n = UI.nav[lang];
const c = UI.cta[lang];
const r = (k: keyof typeof ROUTES) => ROUTES[k][lang];
const current = Astro.url.pathname;

const services = {
  fr: [
    ['planning', 'Organisation clé en main'], ['host', 'Maître de cérémonie & coordination'], ['coordination', 'Coordination du jour J'],
    ['vendors', 'Prestataires'], ['proposal', 'Demande en mariage'], ['forTwo', 'Mariage à deux'], ['anniversary', 'Anniversaire de mariage'], ['weekend', 'Week-end à Paris'],
  ],
  en: [
    ['planning', 'Full wedding planning'], ['host', 'Wedding host & coordination'], ['coordination', 'Day-of coordination'],
    ['vendors', 'Wedding vendors'], ['proposal', 'Proposal in Paris'], ['forTwo', 'Wedding for two'], ['anniversary', 'Wedding anniversary'], ['weekend', 'Weekend in Paris'],
  ],
  ru: [
    ['planning', 'Свадьба под ключ'], ['host', 'Ведущий и координация'], ['coordination', 'Координация дня свадьбы'],
    ['vendors', 'Подрядчики'], ['proposal', 'Предложение в Париже'], ['forTwo', 'Свадьба для двоих'], ['anniversary', 'Годовщина свадьбы'], ['weekend', 'Выходные в Париже'],
  ],
}[lang] as [keyof typeof ROUTES, string][];

const main: [keyof typeof ROUTES, string][] = [
  ['about', n.about], ['services', n.services], ['venues', n.venues], ['portfolio', n.portfolio], ['blog', n.blog], ['contacts', n.contacts],
];
---
<header class:list={['hdr', { 'hdr--over': overHero }]} data-header>
  <div class="hdr__bar">
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <span class="hdr__lines" aria-hidden="true"><span></span><span></span></span>
      <span class="hdr__burger-label">{n.menu}</span>
    </button>

    <a class="hdr__logo" href={r('home')} aria-label="Agence Chance">
      <span class="hdr__mark" aria-hidden="true"></span>
      <span class="hdr__word">
        <span class="hdr__name">Agence Chance</span>
        <span class="hdr__tag">Wedding in France</span>
      </span>
    </a>

    <div class="hdr__right">
      <nav class="lang" aria-label="Language">
        {LANGS.map((l) => (
          <a href={alternates[l] ?? ROUTES.home[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
      <a class="hdr__cta" href={r('contacts')}>{c.consult}</a>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label={n.menu} hidden data-menu>
  <div class="menu__inner">
    <button class="menu__close" type="button" data-menu-close>
      <span aria-hidden="true">×</span> {n.close}
    </button>
    <nav class="menu__main" aria-label={n.menu}>
      <ol>
        {main.map(([k, label], i) => (
          <li style={`--i:${i}`}>
            <a href={r(k)} aria-current={current === r(k) ? 'page' : undefined}><span class="menu__num">0{i + 1}</span>{label}</a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="menu__aside">
      <p class="eyebrow">{n.services}</p>
      <ul class="menu__sub">
        {services.map(([k, label]) => <li><a href={r(k)}>{label}</a></li>)}
      </ul>
      <div class="menu__contact">
        <a href={CONTACT.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
        <a href={CONTACT.telegram} rel="noopener" target="_blank">Telegram</a>
        <a href={CONTACT.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </div>
      <nav class="lang lang--menu" aria-label="Language">
        {LANGS.map((l) => (
          <a href={alternates[l] ?? ROUTES.home[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--hairline);
    transition: background 0.6s var(--ease), color 0.6s var(--ease), border-color 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .hdr--over { background: transparent; color: var(--paper); border-color: transparent; }
  .hdr--over.is-scrolled,
  .hdr.is-scrolled { background: rgba(255, 255, 255, 0.96); color: var(--ink); border-color: var(--hairline); backdrop-filter: blur(8px); }
  .hdr.is-hidden { transform: translateY(-100%); }

  .hdr__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.2rem;
    padding-inline: var(--gutter);
  }
  .hdr__burger {
    display: flex; align-items: center; gap: 0.9rem;
    padding: 0; border: 0; background: none; color: inherit; cursor: pointer;
    font: 400 0.68rem/1 var(--font-body); letter-spacing: 0.26em; text-transform: uppercase;
  }
  .hdr__lines { display: grid; gap: 7px; width: 28px; }
  .hdr__lines span { display: block; height: 1px; background: currentColor; transition: width 0.5s var(--ease); }
  .hdr__lines span:last-child { width: 70%; }
  .hdr__burger:hover .hdr__lines span:last-child { width: 100%; }

  .hdr__logo {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 0.85rem;
  }
  .hdr__mark {
    width: 2.6rem; height: 2.1rem;
    background: var(--plum);
    -webkit-mask: url('/brand/mark-ink.png') center / contain no-repeat;
    mask: url('/brand/mark-ink.png') center / contain no-repeat;
    transition: background 0.6s var(--ease);
  }
  .hdr--over:not(.is-scrolled) .hdr__mark { background: var(--paper); }
  .hdr__word { display: flex; flex-direction: column; line-height: 1.1; }
  .hdr__name { font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; letter-spacing: 0.04em; }
  .hdr__tag { font-size: 0.56rem; letter-spacing: 0.34em; text-transform: uppercase; opacity: 0.7; }

  .hdr__right { display: flex; align-items: center; gap: 2rem; }
  .lang { display: flex; gap: 0.9rem; font-size: 0.66rem; letter-spacing: 0.2em; }
  .lang a { opacity: 0.55; transition: opacity 0.3s; }
  .lang a:hover, .lang a[aria-current] { opacity: 1; }
  .lang a[aria-current] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .hdr__cta {
    padding: 0.95em 1.6em; border: 1px solid currentColor;
    font-size: 0.64rem; letter-spacing: 0.24em; text-transform: uppercase;
    transition: background 0.4s var(--ease), color 0.4s var(--ease);
  }
  .hdr__cta:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .hdr--over:not(.is-scrolled) .hdr__cta:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }

  @media (max-width: 960px) {
    .hdr__cta, .hdr__right .lang { display: none; }
    .hdr__tag { display: none; }
    .hdr__burger-label { display: none; }
    .hdr__bar { height: 4.4rem; }
    .hdr__logo { left: auto; right: var(--gutter); transform: translateY(-50%); }
    .hdr__name { font-size: 1.2rem; }
  }

  /* ---------- Overlay menu ---------- */
  .menu {
    position: fixed; inset: 0; z-index: 200;
    background: var(--ink); color: var(--paper);
    overflow-y: auto;
    opacity: 0; transition: opacity 0.6s var(--ease);
  }
  .menu.is-open { opacity: 1; }
  .menu__inner {
    min-height: 100%;
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 4rem;
    padding: 7rem var(--gutter) 4rem;
    max-width: var(--wide); margin-inline: auto;
  }
  .menu__close {
    position: absolute; top: 1.7rem; left: var(--gutter);
    display: flex; align-items: center; gap: 0.8rem;
    border: 0; background: none; color: inherit; cursor: pointer;
    font: 400 0.68rem/1 var(--font-body); letter-spacing: 0.26em; text-transform: uppercase;
  }
  .menu__close span { font-size: 1.6rem; font-weight: 300; }
  .menu__main ol { list-style: none; }
  .menu__main li {
    border-bottom: 1px solid var(--hairline-light);
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.9s var(--ease) calc(var(--i) * 60ms + 150ms), transform 0.9s var(--ease) calc(var(--i) * 60ms + 150ms);
  }
  .menu.is-open .menu__main li { opacity: 1; transform: none; }
  .menu__main a {
    display: flex; align-items: baseline; gap: 1.6rem;
    padding: 0.9rem 0;
    font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 300; line-height: 1.1;
    transition: color 0.4s, padding 0.6s var(--ease);
  }
  .menu__main a:hover { color: #e9b7d2; padding-left: 0.6rem; }
  .menu__main a[aria-current] { font-style: italic; }
  .menu__num { font-family: var(--font-body); font-size: 0.62rem; letter-spacing: 0.2em; opacity: 0.5; }
  .menu__aside { align-self: end; }
  .menu__aside .eyebrow { color: rgba(255, 255, 255, 0.6); }
  .menu__sub { list-style: none; display: grid; gap: 0.55rem; margin-bottom: 3rem; }
  .menu__sub a { font-size: 0.92rem; opacity: 0.85; transition: opacity 0.3s; }
  .menu__sub a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }
  .menu__contact { display: grid; gap: 0.45rem; margin-bottom: 2.4rem; font-size: 0.8rem; letter-spacing: 0.06em; }
  .menu__contact a { opacity: 0.7; }
  .menu__contact a:hover { opacity: 1; }
  .lang--menu { font-size: 0.75rem; }
  @media (max-width: 860px) {
    .menu__inner { grid-template-columns: 1fr; gap: 3rem; padding-top: 6rem; }
  }
</style>
