---
import Img from './Img.astro';
interface Props {
  image?: string;
  video?: boolean;
  eyebrow?: string;
  title: string;
  lead?: string;
  cta?: { label: string; href: string };
  cta2?: { label: string; href: string };
  position?: string;
  size?: 'full' | 'tall';
  scrollLabel?: string;
}
const { image, video = false, eyebrow, title, lead, cta, cta2, position, size = 'full', scrollLabel } = Astro.props;
---
<section class:list={['hero', `hero--${size}`, 'on-dark']}>
  <div class="hero__media">
    {video ? (
      <video
        muted
        loop
        playsinline
        preload="none"
        poster="/video/hero-poster.webp"
        data-autoplay
        data-src="/video/hero-1080.mp4"
        data-src-small="/video/hero-540.mp4"
        aria-hidden="true"
      ></video>
    ) : image ? (
      <Img base={image} eager sizes="100vw" position={position} />
    ) : null}
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__content wrap">
    {eyebrow && <p class="eyebrow eyebrow--rule hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title" set:html={title} />
    {lead && <p class="hero__lead">{lead}</p>}
    {(cta || cta2) && (
      <div class="actions">
        {cta && <a class="btn btn--light" href={cta.href}>{cta.label}</a>}
        {cta2 && <a class="link-arrow" href={cta2.href}>{cta2.label}</a>}
      </div>
    )}
  </div>
  {scrollLabel && <a class="hero__scroll" href="#after-hero"><span>{scrollLabel}</span></a>}
</section>
<div id="after-hero"></div>

<style>
  .hero { position: relative; display: flex; align-items: flex-end; color: var(--paper); overflow: hidden; background: var(--ink); }
  .hero--full { min-height: 100vh; min-height: 100svh; }
  .hero--tall { min-height: 88vh; min-height: 88svh; }
  .hero__media, .hero__veil { position: absolute; inset: 0; }
  .hero__media :global(img), .hero__media video { width: 100%; height: 100%; object-fit: cover; }
  .hero__media video { background: url('/video/hero-poster.webp') center / cover; }
  .hero__media :global(img) { animation: hero-zoom 14s var(--ease) both; }
  @keyframes hero-zoom { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero__veil { background: linear-gradient(90deg, rgba(20, 14, 18, 0.55) 0%, rgba(20, 14, 18, 0.18) 55%, rgba(20, 14, 18, 0) 100%), linear-gradient(180deg, rgba(20, 14, 18, 0.4) 0%, rgba(20, 14, 18, 0) 28%, rgba(20, 14, 18, 0.45) 100%); }
  .hero__content { position: relative; padding-bottom: clamp(5rem, 12vh, 9rem); padding-top: 9rem; }
  .hero__eyebrow { color: rgba(255, 255, 255, 0.85) !important; animation: rise 1.4s var(--ease) 0.2s both; }
  .hero__title {
    max-width: 15ch;
    font-size: var(--fs-display);
    font-weight: 300;
    line-height: 1;
    animation: rise 1.6s var(--ease) 0.35s both;
  }
  .hero__title :global(em) { font-style: italic; color: inherit; }
  .hero__lead { max-width: 34rem; margin-top: 2rem; font-size: 1.02rem; line-height: 1.75; color: rgba(255, 255, 255, 0.88); animation: rise 1.6s var(--ease) 0.5s both; }
  .hero .actions { animation: rise 1.6s var(--ease) 0.65s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
  .hero__scroll {
    position: absolute; right: var(--gutter); bottom: 2.5rem;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; writing-mode: vertical-rl;
  }
  .hero__scroll::after { content: ''; width: 1px; height: 4rem; background: linear-gradient(currentColor, transparent); animation: drip 2.4s var(--ease) infinite; }
  @keyframes drip { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (max-width: 760px) { .hero__scroll { display: none; } }
</style>
