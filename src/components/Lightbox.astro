<dialog class="lightbox" data-lightbox aria-label="Gallery">
  <img alt="" />
  <button type="button" class="lightbox__btn lightbox__btn--prev" data-lb-prev aria-label="Previous">‹</button>
  <button type="button" class="lightbox__btn lightbox__btn--next" data-lb-next aria-label="Next">›</button>
  <button type="button" class="lightbox__close" data-lb-close aria-label="Close">×</button>
</dialog>

<style is:global>
  /* ---- lightbox ---- */
  .lightbox { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(15, 10, 13, 0.96); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: 92vw; max-height: 88vh; width: auto; height: auto; object-fit: contain; }
  .lightbox__btn, .lightbox__close { position: absolute; border: 0; background: none; color: #fff; font: 300 3rem/1 var(--font-display); cursor: pointer; padding: 1rem 1.4rem; opacity: 0.7; }
  .lightbox__btn:hover, .lightbox__close:hover { opacity: 1; }
  .lightbox__btn--prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lightbox__btn--next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lightbox__close { top: 1rem; right: 1rem; }
</style>
