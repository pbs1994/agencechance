# GENERATED by scripts/gen-redirects.mjs — edit src/data/redirects.json instead.
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

AddType video/mp4 .mp4
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(webp|jpg|png|mp4|woff2?|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Secrets of the contact form never served
<FilesMatch "^(config\.php|.*\.log)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# HTTPS + bare domain
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://agencechance.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.agencechance\.com$ [NC]
RewriteRule ^ https://agencechance.com%{REQUEST_URI} [R=301,L]

# Former WordPress endpoints: gone for good
RewriteRule ^(wp-admin|wp-includes|wp-json|wp-content/(plugins|themes|cache))(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup)\.php$ - [G,L]

# Root -> French home
RewriteRule ^$ https://agencechance.com/fr/ [R=301,L]

# WordPress archives that no longer exist
RewriteRule ^(fr|en|ru)/blog/\d{4}(/\d{2}(/\d{2})?)?/?$ https://agencechance.com/$1/blog/ [R=301,L]
RewriteRule ^(fr|en|ru)/blog/page/\d+/?$ https://agencechance.com/$1/blog/ [R=301,L]
RewriteRule ^((fr|en|ru)/)?(comments/)?feed/?$ https://agencechance.com/fr/blog/ [R=301,L]
RewriteRule ^(fr|en|ru)/(info|information)(/page/\d+)?/?$ https://agencechance.com/$1/blog/ [R=301,L]

# Directories without trailing slash: add it (absolute https, one hop)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://agencechance.com/$1/ [R=301,L]

# Legacy pages (one hop each)
RewriteRule ^about/?$ https://agencechance.com/ru/about-us/ [R=301,L]
